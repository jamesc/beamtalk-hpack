/// Port of hpax's `HPAXTest`, plus the RFC 7541 Appendix C examples end to
/// end.
///
/// hpax's StreamData properties become seeded random loops (`seedRandom:`
/// plus class-side `Random`, as Catalina's fuzz seeds `rand`). The two
/// joedevivo/hpack interop properties have no Beamtalk counterpart — that
/// library is not a dependency — so cross-implementation agreement rests on
/// the RFC vectors below and the hpax-differential fixture
/// (`test/fixtures/hpax_vectors.txt`, generated by `bench/gen_vectors.exs`).
TestCase subclass: HPACKTest

  // === HPAX basics ===
  testNew =>
    t := HPACK newTable: 100
    self assert: t protocolMaxTableSize equals: 100
    self assert: t huffmanEncoding equals: #never

  testNewHuffman =>
    t := HPACK newTable: 100 huffman: #always
    self assert: t huffmanEncoding equals: #always

  testNewBadHuffman =>
    self should: [HPACK newTable: 100 huffman: #sometimes] raise: #user_error

  testResize =>
    t := HPACK resize: (HPACK newTable: 4096) newMax: 8192
    self assert: t protocolMaxTableSize equals: 8192

  testDecodeSpecExample =>
    // RFC 7541 §C.2.1.
    t := HPACK newTable: 1000
    dump := Binary fromBytes: #(64, 10, 99, 117, 115, 116, 111, 109, 45, 107, 101, 121, 13, 99, 117, 115, 116, 111, 109, 45, 104, 101, 97, 100, 101, 114)
    {#ok, headers, table} := HPACK decode: dump table: t
    self assertHeaders: headers equals: #({(self bin: "custom-key"), (self bin: "custom-header")})
    self assert: table entries equals: #({(self bin: "custom-key"), (self bin: "custom-header")})

  testEncodeLiteralExample =>
    // RFC 7541 §C.3.1, no Huffman.
    t := HPACK newTable: 1000 huffman: #never
    headers := #({#store, ":method", "GET"}, {#store, ":scheme", "http"}, {#store, ":path", "/"}, {#store, ":authority", "www.example.com"})
    {io, _} := HPACK encode: headers table: t
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 65, 15, 119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109)

  testEncodeHuffmanExample =>
    // RFC 7541 §C.4.1, Huffman.
    t := HPACK newTable: 1000 huffman: #always
    headers := #({#store, ":method", "GET"}, {#store, ":scheme", "http"}, {#store, ":path", "/"}, {#store, ":authority", "www.example.com"})
    {io, _} := HPACK encode: headers table: t
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 65, 140, 241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255)

  testManualTableOps =>
    enc := HPACK newTable: 1000
    dec := HPACK newTable: 1000
    {io, enc} := HPACK encode: #({#store, "a", "A"}) table: enc
    {#ok, headers, dec} := HPACK decode: (self wire: io) table: dec
    self assertHeaders: headers equals: #({"a", "A"})
    self assert: dec entries equals: #({(self bin: "a"), (self bin: "A")})
    {io, enc} := HPACK encode: #({#store_name, "a", "other"}) table: enc
    {#ok, headers, dec} := HPACK decode: (self wire: io) table: dec
    self assertHeaders: headers equals: #({"a", "other"})
    self assert: dec entries equals: #({(self bin: "a"), (self bin: "A")})
    {io, enc} := HPACK encode: #({#store_name, "b", "B"}) table: enc
    {#ok, headers, dec} := HPACK decode: (self wire: io) table: dec
    self assertHeaders: headers equals: #({"b", "B"})
    self assert: dec entries equals: #({(self bin: "b"), (self bin: "B")}, {(self bin: "a"), (self bin: "A")})
    {io, enc} := HPACK encode: #({#no_store, "c", "C"}) table: enc
    {#ok, headers, dec} := HPACK decode: (self wire: io) table: dec
    self assertHeaders: headers equals: #({"c", "C"})
    self assert: dec entries equals: #({(self bin: "b"), (self bin: "B")}, {(self bin: "a"), (self bin: "A")})

  testEncodeInvalidHeaders =>
    t := HPACK newTable: 1000
    self should: [
      HPACK encode: #({#store, #foo, "bar"}) table: t
    ] raise: #user_error
    self should: [
      HPACK encode: #({#store, "foo", #bar}) table: t
    ] raise: #user_error
    self
      should: [
        HPACK
          encode: #bogus
          headers: #({"a", "b"})
          table: t
      ]
      raise: #user_error

  testDecodeEmpty =>
    {#ok, headers, t} := HPACK decode: (Binary fromBytes: #()) table: (HPACK newTable: 1000)
    self assert: headers equals: #()
    self assert: t entries equals: #()

  testDecodeBadIndex =>
    // Index 0 is never valid.
    self assert: (HPACK decode: (Binary fromBytes: #(128)) table: (HPACK newTable: 1000)) equals: {#error, {#index_not_found, 0}}
    // Past the empty dynamic table.
    self assert: (HPACK decode: (Binary fromBytes: #(190)) table: (HPACK newTable: 1000)) equals: {#error, {#index_not_found, 62}}

  testDecodeTruncated =>
    self assert: (HPACK decode: (Binary fromBytes: #(65)) table: (HPACK newTable: 1000)) equals: {#error, #bad_binary_encoding}

  // === RFC 7541 Appendix C.2: representation examples (decode) ===
  testRfcC21 =>
    {#ok, headers, t} := HPACK decode: (Binary fromBytes: #(64, 10, 99, 117, 115, 116, 111, 109, 45, 107, 101, 121, 13, 99, 117, 115, 116, 111, 109, 45, 104, 101, 97, 100, 101, 114)) table: (HPACK newTable: 4096)
    self assertHeaders: headers equals: #({"custom-key", "custom-header"})
    self assert: t size equals: 55

  testRfcC22 =>
    // Indexed name, no indexing: nothing stored.
    {#ok, headers, t} := HPACK decode: (Binary fromBytes: #(4, 12, 47, 115, 97, 109, 112, 108, 101, 47, 112, 97, 116, 104)) table: (HPACK newTable: 4096)
    self assertHeaders: headers equals: #({":path", "/sample/path"})
    self assert: t entries equals: #()

  testRfcC23 =>
    // Never-indexed literal name and value.
    {#ok, headers, t} := HPACK decode: (Binary fromBytes: #(16, 8, 112, 97, 115, 115, 119, 111, 114, 100, 6, 115, 101, 99, 114, 101, 116)) table: (HPACK newTable: 4096)
    self assertHeaders: headers equals: #({"password", "secret"})
    self assert: t entries equals: #()

  testRfcC24 =>
    {#ok, headers, t} := HPACK decode: (Binary fromBytes: #(130)) table: (HPACK newTable: 4096)
    self assertHeaders: headers equals: #({":method", "GET"})
    self assert: t entries equals: #()

  // === RFC 7541 Appendix C.3: requests without Huffman ===
  testRfcC3Requests =>
    enc := HPACK newTable: 4096 huffman: #never
    dec := HPACK newTable: 4096 huffman: #never
    req1 := #({":method", "GET"}, {":scheme", "http"}, {":path", "/"}, {":authority", "www.example.com"})
    // First request: decode the RFC bytes, and encode to the same bytes.
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 134, 132, 65, 15, 119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109)) table: dec
    self assertHeaders: headers equals: req1
    self assert: dec size equals: 57
    {io, enc} := HPACK
      encode: #store
      headers: req1
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 65, 15, 119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109)
    // Second request: :authority arrives indexed from the dynamic table.
    req2 := #({":method", "GET"}, {":scheme", "http"}, {":path", "/"}, {":authority", "www.example.com"}, {"cache-control", "no-cache"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 134, 132, 190, 88, 8, 110, 111, 45, 99, 97, 99, 104, 101)) table: dec
    self assertHeaders: headers equals: req2
    self assert: dec size equals: 110
    {io, enc} := HPACK
      encode: #store
      headers: req2
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 190, 88, 8, 110, 111, 45, 99, 97, 99, 104, 101)
    // Third request: new scheme and path index statically; custom pair stores.
    req3 := #({":method", "GET"}, {":scheme", "https"}, {":path", "/index.html"}, {":authority", "www.example.com"}, {"custom-key", "custom-value"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 135, 133, 191, 64, 10, 99, 117, 115, 116, 111, 109, 45, 107, 101, 121, 12, 99, 117, 115, 116, 111, 109, 45, 118, 97, 108, 117, 101)) table: dec
    self assertHeaders: headers equals: req3
    self assert: dec size equals: 164
    {io, enc} := HPACK
      encode: #store
      headers: req3
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 135, 133, 191, 64, 10, 99, 117, 115, 116, 111, 109, 45, 107, 101, 121, 12, 99, 117, 115, 116, 111, 109, 45, 118, 97, 108, 117, 101)

  // === RFC 7541 Appendix C.4: requests with Huffman ===
  testRfcC4Requests =>
    enc := HPACK newTable: 4096 huffman: #always
    dec := HPACK newTable: 4096 huffman: #always
    req1 := #({":method", "GET"}, {":scheme", "http"}, {":path", "/"}, {":authority", "www.example.com"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 134, 132, 65, 140, 241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255)) table: dec
    self assertHeaders: headers equals: req1
    self assert: dec size equals: 57
    {io, enc} := HPACK
      encode: #store
      headers: req1
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 65, 140, 241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255)
    req2 := #({":method", "GET"}, {":scheme", "http"}, {":path", "/"}, {":authority", "www.example.com"}, {"cache-control", "no-cache"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 134, 132, 190, 88, 134, 168, 235, 16, 100, 156, 191)) table: dec
    self assertHeaders: headers equals: req2
    self assert: dec size equals: 110
    {io, enc} := HPACK
      encode: #store
      headers: req2
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 134, 132, 190, 88, 134, 168, 235, 16, 100, 156, 191)
    req3 := #({":method", "GET"}, {":scheme", "https"}, {":path", "/index.html"}, {":authority", "www.example.com"}, {"custom-key", "custom-value"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(130, 135, 133, 191, 64, 136, 37, 168, 73, 233, 91, 169, 125, 127, 137, 37, 168, 73, 233, 91, 184, 232, 180, 191)) table: dec
    self assertHeaders: headers equals: req3
    self assert: dec size equals: 164
    {io, enc} := HPACK
      encode: #store
      headers: req3
      table: enc
    self assert: (self wire: io) toBytes equals: #(130, 135, 133, 191, 64, 136, 37, 168, 73, 233, 91, 169, 125, 127, 137, 37, 168, 73, 233, 91, 184, 232, 180, 191)

  // === RFC 7541 Appendix C.5: responses with eviction (table size 256) ===
  testRfcC5Responses =>
    dec := HPACK newTable: 256
    resp1 := #({":status", "302"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:21 GMT"}, {"location", "https://www.example.com"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(72, 3, 51, 48, 50, 88, 7, 112, 114, 105, 118, 97, 116, 101, 97, 29, 77, 111, 110, 44, 32, 50, 49, 32, 79, 99, 116, 32, 50, 48, 49, 51, 32, 50, 48, 58, 49, 51, 58, 50, 49, 32, 71, 77, 84, 110, 23, 104, 116, 116, 112, 115, 58, 47, 47, 119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109)) table: dec
    self assertHeaders: headers equals: resp1
    resp2 := #({":status", "307"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:21 GMT"}, {"location", "https://www.example.com"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(72, 3, 51, 48, 55, 193, 192, 191)) table: dec
    self assertHeaders: headers equals: resp2
    self assert: dec size equals: 222
    resp3 := #({":status", "200"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:22 GMT"}, {"location", "https://www.example.com"}, {"content-encoding", "gzip"}, {"set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(136, 193, 97, 29, 77, 111, 110, 44, 32, 50, 49, 32, 79, 99, 116, 32, 50, 48, 49, 51, 32, 50, 48, 58, 49, 51, 58, 50, 50, 32, 71, 77, 84, 192, 90, 4, 103, 122, 105, 112, 119, 56, 102, 111, 111, 61, 65, 83, 68, 74, 75, 72, 81, 75, 66, 90, 88, 79, 81, 87, 69, 79, 80, 73, 85, 65, 88, 81, 87, 69, 79, 73, 85, 59, 32, 109, 97, 120, 45, 97, 103, 101, 61, 51, 54, 48, 48, 59, 32, 118, 101, 114, 115, 105, 111, 110, 61, 49)) table: dec
    self assertHeaders: headers equals: resp3
    self assert: dec size equals: 215

  // === RFC 7541 Appendix C.6: responses with Huffman ===
  testRfcC6Responses =>
    dec := HPACK newTable: 256 huffman: #always
    resp1 := #({":status", "302"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:21 GMT"}, {"location", "https://www.example.com"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(72, 130, 100, 2, 88, 133, 174, 195, 119, 26, 75, 97, 150, 208, 122, 190, 148, 16, 84, 212, 68, 168, 32, 5, 149, 4, 11, 129, 102, 224, 130, 166, 45, 27, 255, 110, 145, 157, 41, 173, 23, 24, 99, 199, 143, 11, 151, 200, 233, 174, 130, 174, 67, 211)) table: dec
    self assertHeaders: headers equals: resp1
    resp2 := #({":status", "307"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:21 GMT"}, {"location", "https://www.example.com"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(72, 131, 100, 14, 255, 193, 192, 191)) table: dec
    self assertHeaders: headers equals: resp2
    self assert: dec size equals: 222
    // C.6.3's dump in the RFC text interleaves decode-walk bytes; these
    // bytes are hpax's encoding of the same headers, verified byte-identical
    // to the RFC dump's 79 bytes and round-tripping through hpax itself.
    resp3 := #({":status", "200"}, {"cache-control", "private"}, {"date", "Mon, 21 Oct 2013 20:13:22 GMT"}, {"location", "https://www.example.com"}, {"content-encoding", "gzip"}, {"set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"})
    {#ok, headers, dec} := HPACK decode: (Binary fromBytes: #(136, 193, 97, 150, 208, 122, 190, 148, 16, 84, 212, 68, 168, 32, 5, 149, 4, 11, 129, 102, 224, 132, 166, 45, 27, 255, 192, 90, 131, 155, 217, 171, 119, 173, 148, 231, 130, 29, 215, 242, 230, 199, 179, 53, 223, 223, 205, 91, 57, 96, 213, 175, 39, 8, 127, 54, 114, 193, 171, 39, 15, 181, 41, 31, 149, 135, 49, 96, 101, 192, 3, 237, 78, 229, 177, 6, 61, 80, 7)) table: dec
    self assertHeaders: headers equals: resp3
    self assert: dec size equals: 215

  // === Dynamic table size updates (hpax's resize properties) ===
  testEncodePrependsResizes =>
    enc := HPACK newTable: 20000
    dec := HPACK newTable: 20000
    {io, enc} := HPACK encode: #({#store, "bogus", "BOGUS"}) table: enc
    {#ok, _, dec} := HPACK decode: (self wire: io) table: dec
    self assert: dec size equals: enc size
    // The decoder grows via settings; the encoder answers smaller.
    dec := HPACK resize: dec newMax: 40000
    enc := HPACK resize: enc newMax: 30000
    {io, enc} := HPACK encode: #({#store, "lame", "LAME"}) table: enc
    wire := self wire: io
    self assert: ((wire byteAt: 0) bitAnd: 224) equals: 32
    {#ok, _, dec} := HPACK decode: wire table: dec
    self assert: dec size equals: enc size
    self assert: enc maxTableSize equals: 30000
    self assert: dec maxTableSize equals: 30000
    // Shrinking twice queues two updates, smallest first.
    dec := HPACK resize: dec newMax: 10000
    enc := HPACK resize: enc newMax: 0
    enc := HPACK resize: enc newMax: 1234
    {io, enc} := HPACK encode: #({#store, "lame", "LAME"}) table: enc
    wire := self wire: io
    self assert: ((wire byteAt: 0) bitAnd: 224) equals: 32
    {#ok, _, dec} := HPACK decode: wire table: dec
    self assert: dec size equals: enc size
    self assert: enc maxTableSize equals: 1234
    self assert: dec maxTableSize equals: 1234

  testDecodeAcceptsResizeAtStart =>
    enc := HPACK newTable: 20000
    dec := HPACK newTable: 20000
    {io, enc} := HPACK encode: #({#store, "bogus", "BOGUS"}) table: enc
    {#ok, _, dec} := HPACK decode: (self wire: io) table: dec
    oldSize := enc size
    {io, _} := HPACK encode: #({#store, "lame", "LAME"}) table: dec
    wire := (Binary fromBytes: #(32)) concat: (self wire: io)
    {#ok, _, dec} := HPACK decode: wire table: dec
    self assert: dec size equals: (enc size) - oldSize
    self assert: dec maxTableSize equals: 0

  testDecodeRejectsMidBlockResizeSeeded =>
    self seedRandom: 40800511
    enc := HPACK newTable: 20000
    dec := HPACK newTable: 20000
    50
      timesRepeat: [
        headers := self randomStoreHeaders: 1 + ((Random nextInteger: 3) - 1)
        {io, _} := HPACK encode: headers table: enc
        wire := (self wire: io) concat: (Binary fromBytes: #(32))
        self assert: (HPACK decode: wire table: dec) equals: {#error, #protocol_error}
      ]

  testDecodeRejectsOversizeResizeSeeded =>
    self seedRandom: 40800512
    enc := HPACK newTable: 29
    dec := HPACK newTable: 29
    50
      timesRepeat: [
        headers := self randomStoreHeaders: 1 + ((Random nextInteger: 3) - 1)
        {io, _} := HPACK encode: headers table: enc
        wire := (Binary fromBytes: #(63)) concat: (self wire: io)
        self assert: (HPACK decode: wire table: dec) equals: {#error, #protocol_error}
      ]

  // === Seeded loops (hpax's StreamData properties) ===
  testSingleActionCircularSeeded =>
    self seedRandom: 40800521
    t := HPACK newTable: 500
    100
      timesRepeat: [
        action := #(#store, #store_name, #no_store, #never_store) at: (Random nextInteger: 4)
        headers := self randomHeaders: (Random nextInteger: 4) - 1
        {io, t} := HPACK
          encode: action
          headers: headers
          table: t
        result := HPACK decode: (self wire: io) table: t
        self assert: (result at: 1) equals: #ok
        self assertHeaders: (result at: 2) equals: headers
      ]

  testEncodeDecodeCircularSeeded =>
    self seedRandom: 40800522
    t := HPACK newTable: 500
    100
      timesRepeat: [
        headers := self randomActionHeaders: (Random nextInteger: 4) - 1
        {io, t} := HPACK encode: headers table: t
        result := HPACK decode: (self wire: io) table: t
        self assert: (result at: 1) equals: #ok
        self assertHeaders: (result at: 2) equals: (self plainHeaders: headers)
      ]

  // === Helpers ===
  bin: s -> Binary => Binary fromIolist: s

  wire: io -> Binary => Binary fromIolist: io

  /// See HPACKTypesTest: one FFI line seeds process-dictionary `rand`; all
  /// draws stay `Random nextInteger:`.
  seedRandom: s -> Nil =>
    (Erlang rand) seed: #exsss with: {s, s + 1000, s + 2000}
    nil

  /// Assert two header lists hold the same bytes, whatever their classes
  /// (decoded output mixes `String` static hits with `Binary` literals).
  assertHeaders: actual equals: expected -> Nil =>
    self assert: (actual collect: [:h |
      self flatPair: h
    ]) equals: (expected collect: [:h | self flatPair: h])

  flatPair: h -> Tuple =>
    (h at: 2) isNil ifTrue: [
      ^{(h at: 1) toBytes, nil}
    ] ifFalse: [^{(h at: 1) toBytes, (h at: 2) toBytes}]

  plainHeaders: headers -> List =>
    headers collect: [:h | {(h at: 2), (h at: 3)}]

  randomBytes: n -> List =>
    n =:= 0 ifTrue: [^#()]
    self randomBytes: n - 1 into: #()

  randomBytes: n into: acc =>
    n =:= 0 ifTrue: [^acc]
    self randomBytes: n - 1 into: (acc addFirst: (Random nextInteger: 256) - 1)

  randomName -> Binary =>
    (Random nextInteger: 3) =:= 1
      ifTrue: [
        HPACKTypes canon: (self staticNames at: (Random nextInteger: self staticNames size))
      ]
      ifFalse: [
        Binary fromBytes: (self randomBytes: 1 + ((Random nextInteger: 10) - 1))
      ]

  staticNames -> List => HPACKTable staticTable collect: [:e | e at: 1]

  randomHeaders: n -> List =>
    n =:= 0 ifTrue: [^#()]
    #({self randomName, (Binary fromBytes: (self randomBytes: (Random nextInteger: 17) - 1))})
      ++ (self randomHeaders: n - 1)

  randomStoreHeaders: n -> List =>
    (self randomHeaders: n) collect: [:h | {#store, (h at: 1), (h at: 2)}]

  randomActionHeaders: n -> List =>
    (self randomHeaders: n)
      collect: [:h |
        {#(#store, #store_name, #no_store, #never_store) at: (Random nextInteger: 4), (h at: 1), (h at: 2)}
      ]
